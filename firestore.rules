rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // Profiles Collection
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(profileId);
      allow update: if isSignedIn() && isValidId(profileId) && (resource.data.userId == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(profileId) && (resource.data.userId == null || resource.data.userId == request.auth.uid);
    }
  }
}
